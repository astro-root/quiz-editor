diff --git a/src/components/AnswerDupNotice.tsx b/src/components/AnswerDupNotice.tsx
new file mode 100644
index 0000000..c64fb97
--- /dev/null
+++ b/src/components/AnswerDupNotice.tsx
@@ -0,0 +1,21 @@
+import { AlertTriangle } from "lucide-react";
+import { AnswerDup } from "@/lib/QuestionsContext";
+
+// 同じ答え（別解を含む）の問題が既にあるときの、お知らせ。保存は止めない。
+export function AnswerDupNotice({ dups, personName }: { dups: AnswerDup[]; personName: (uid: string, fallback: string) => string }) {
+  if (dups.length === 0) return null;
+  const shown = dups.slice(0, 3);
+  return (
+    <div role="status" className="mb-2 rounded-lg bg-amber-50 px-2.5 py-1.5 text-xs text-warn-strong">
+      <p className="flex items-center gap-1.5 font-medium"><AlertTriangle size={13} />同じ答えの問題が、すでに{dups.length}件あります</p>
+      <ul className="mt-1 space-y-0.5">
+        {shown.map(({ question: q, matched }) => (
+          <li key={q.id} className="truncate">
+            「{matched}」… {q.body.trim().slice(0, 40) || "（問題文なし）"}{q.body.trim().length > 40 ? "…" : ""}（{personName(q.authorUid, q.authorName)}）
+          </li>
+        ))}
+        {dups.length > shown.length && <li>ほか {dups.length - shown.length} 件</li>}
+      </ul>
+    </div>
+  );
+}
diff --git a/src/components/ListInput.tsx b/src/components/ListInput.tsx
new file mode 100644
index 0000000..1d11084
--- /dev/null
+++ b/src/components/ListInput.tsx
@@ -0,0 +1,29 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+// 別解・タグのような、複数の値を1つの欄で入力する。区切りは「,」「、」「，」と改行。
+// 入力中の文字は、そのまま欄に残す（区切りの直後に「,」が消えて、続けて打てない不具合の対策）。
+export const parseList = (s: string) => s.split(/[,、，\n]/).map((x) => x.trim()).filter(Boolean);
+const sameList = (a: string[], b: string[]) => a.length === b.length && a.every((x, i) => x === b[i]);
+
+export function ListInput({ value, onChange, disabled, className, placeholder, ariaLabel }: {
+  value: string[]; onChange: (v: string[]) => void; disabled?: boolean; className?: string; placeholder?: string; ariaLabel?: string;
+}) {
+  const [raw, setRaw] = useState(() => value.join(", "));
+  // 外から値が変わったとき（書きかけの復元・クリアなど）だけ、欄の文字を作り直す
+  useEffect(() => {
+    setRaw((cur) => (sameList(parseList(cur), value) ? cur : value.join(", ")));
+  }, [value]);
+  return (
+    <input
+      value={raw}
+      disabled={disabled}
+      placeholder={placeholder}
+      aria-label={ariaLabel}
+      onChange={(e) => { setRaw(e.target.value); onChange(parseList(e.target.value)); }}
+      onBlur={() => setRaw(parseList(raw).join(", "))}
+      className={className}
+    />
+  );
+}

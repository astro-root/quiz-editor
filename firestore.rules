rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- users ----
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- questionSets ----
    match /questionSets/{setId} {

      function membersMap() {
        return resource.data.members;
      }
      function isMember() {
        return request.auth != null && request.auth.uid in membersMap();
      }
      function roleOf() {
        return membersMap()[request.auth.uid];
      }
      function isAdmin() {
        return isMember() && roleOf() == 'admin';
      }
      function isSupervisorOrAbove() {
        return isMember() && (roleOf() == 'admin' || roleOf() == 'supervisor');
      }
      function isWriterOrAbove() {
        return isMember()
          && (roleOf() == 'admin' || roleOf() == 'supervisor' || roleOf() == 'writer');
      }

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'admin';

      allow read: if isMember();

      // 通常の更新（名前・お知らせ）は管理者のみ。
      // ジャンル追加は管理者・問題統括。
      // 招待の承諾は本人が自分をmembers/memberProfilesに追加する場合のみ。
      allow update: if isAdmin()
        || (isSupervisorOrAbove()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['genres', 'updatedAt']))
        || acceptingOwnInvite()
        || migratingOwnLegacyRole();

      function acceptingOwnInvite() {
        let email = request.auth.token.email;
        let invitePath = /databases/$(database)/documents/invites/$(email);
        let onlyMembersAndTimestampChanged =
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberProfiles', 'updatedAt']);
        return request.auth != null
          && email != null
          && exists(invitePath)
          && get(invitePath).data.setId == setId
          && request.resource.data.members[request.auth.uid] == get(invitePath).data.role
          && onlyMembersAndTimestampChanged;
      }

      // 旧バージョン（owner/editor）のロール名が残っているドキュメントを、
      // 本人が自分の分だけ新しいロール名（admin/writer）に自動移行できるようにする。
      // 他人のロールを変更できないよう、変更後もmembersマップの中で
      // 自分のキー以外が一切変わっていないことを検証する。
      function legacyRoleFixed(before) {
        return before == 'owner' ? 'admin' : 'writer';
      }
      function migratingOwnLegacyRole() {
        let uid = request.auth.uid;
        let before = resource.data.members[uid];
        return request.auth != null
          && (before == 'owner' || before == 'editor')
          && request.resource.data.members[uid] == legacyRoleFixed(before)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid]);
      }

      allow delete: if isAdmin();

      match /questions/{questionId} {
        function parentSet() {
          return get(/databases/$(database)/documents/questionSets/$(setId)).data;
        }
        function myRole() {
          return parentSet().members[request.auth.uid];
        }
        function isMemberOfParent() {
          return request.auth != null && request.auth.uid in parentSet().members;
        }
        function isWriterOrAboveOfParent() {
          return isMemberOfParent()
            && (myRole() == 'admin' || myRole() == 'supervisor' || myRole() == 'writer');
        }
        function isSupervisorOrAboveOfParent() {
          return isMemberOfParent() && (myRole() == 'admin' || myRole() == 'supervisor');
        }
        // 作問者はステータスをdraft/completedにしか変更できない。
        function statusChangeAllowed() {
          let before = resource.data.status;
          let after = request.resource.data.status;
          return before == after
            || isSupervisorOrAboveOfParent()
            || (myRole() == 'writer' && after in ['draft', 'completed']);
        }
        // 校正状態は問題統括・管理者のみ変更できる。
        function proofreadChangeAllowed() {
          return resource.data.proofreadStatus == request.resource.data.proofreadStatus
            || isSupervisorOrAboveOfParent();
        }

        allow read: if isMemberOfParent();
        allow create: if isWriterOrAboveOfParent()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSupervisorOrAboveOfParent()
          || (myRole() == 'writer'
              && resource.data.authorUid == request.auth.uid
              && statusChangeAllowed()
              && proofreadChangeAllowed());
        allow delete: if isSupervisorOrAboveOfParent()
          || (myRole() == 'writer' && resource.data.authorUid == request.auth.uid);

        // コメントは役割を問わず、そのセットのメンバーなら誰でも投稿できる。
        match /comments/{commentId} {
          allow read: if isMemberOfParent();
          allow create: if isMemberOfParent()
            && request.resource.data.authorUid == request.auth.uid;
          allow update, delete: if request.auth != null
            && resource.data.authorUid == request.auth.uid;
        }

        // 変更履歴（ステータス・校正状態のみ）。追記のみで編集・削除は不可。
        match /history/{historyId} {
          allow read: if isMemberOfParent();
          allow create: if isMemberOfParent()
            && request.resource.data.authorUid == request.auth.uid;
          allow update, delete: if false;
        }

        // 問題文・答えの改訂スナップショット。問題統括・管理者のみ作成できる。
        match /revisions/{revisionId} {
          allow read: if isMemberOfParent();
          allow create: if isSupervisorOrAboveOfParent()
            && request.resource.data.editedByUid == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /pendingInvites/{email} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow delete: if isAdmin()
          || (request.auth != null && request.auth.token.email == email);
        allow update: if false;
      }
    }

    // ---- invites ----
    match /invites/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow create: if request.auth != null
        && request.resource.data.invitedBy == request.auth.uid
        && get(/databases/$(database)/documents/questionSets/$(request.resource.data.setId))
             .data.members[request.auth.uid] == 'admin';
      allow delete: if request.auth != null
        && (request.auth.token.email == email
            || get(/databases/$(database)/documents/questionSets/$(resource.data.setId))
                 .data.members[request.auth.uid] == 'admin');
      allow update: if false;
    }
  }
}

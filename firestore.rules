rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- users ----
    // 自分自身のプロフィールのみ読み書きできる。
    // 他人のuidを指定して他人の情報を読めないようにする。
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- questionSets ----
    match /questionSets/{setId} {

      function membersMap() {
        return resource.data.members;
      }
      function isMember() {
        return request.auth != null && request.auth.uid in membersMap();
      }
      function roleOf() {
        return membersMap()[request.auth.uid];
      }
      function isOwner() {
        return isMember() && roleOf() == 'owner';
      }
      function isEditorOrAbove() {
        return isMember() && (roleOf() == 'owner' || roleOf() == 'editor');
      }

      // 新規作成時はまだresource.dataが無いので、送信データ側を検証する。
      // 作成者自身がownerとしてmembersに含まれていることを必須にする。
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'owner';

      // 問題セットに所属していないユーザーはIDを知っていても読めない。
      allow read: if isMember();

      // 通常の更新（名前変更・updatedAtなど）はオーナーのみ。
      // 例外：招待の承諾時は、招待の受信者本人が自分をmembersに
      // 追加することだけを許可する（Cloud Functions不使用の設計）。
      allow update: if isOwner()
        || acceptingOwnInvite();

      function acceptingOwnInvite() {
        let email = request.auth.token.email;
        let invitePath = /databases/$(database)/documents/invites/$(email);
        let inviteExists = existsAfter(invitePath) == false && exists(invitePath);
        let invite = exists(invitePath) ? get(invitePath).data : null;
        let onlyMembersAndTimestampChanged =
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'updatedAt']);
        return request.auth != null
          && email != null
          && exists(invitePath)
          && get(invitePath).data.setId == setId
          && request.resource.data.members[request.auth.uid] == get(invitePath).data.role
          && onlyMembersAndTimestampChanged;
      }

      allow delete: if isOwner();

      match /questions/{questionId} {
        allow read: if isMember();
        allow create, update, delete: if isEditorOrAbove();
      }
    }

    // ---- invites ----
    // ドキュメントIDはメールアドレスそのもの。
    // 本人（自分のメールアドレスに一致するトークンを持つユーザー）だけが
    // 自分宛の招待を読める。招待の作成・削除はオーナーが行う想定だが、
    // 招待の削除（承諾完了後のクリーンアップ）は本人にも許可する。
    match /invites/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      // 招待の作成は、招待先のquestionSetの実際のオーナーだけが行える。
      // request.resource.data.invitedByを自分のuidに固定し、
      // かつその問題セットで自分がownerロールであることを検証する
      // （UI側の権限チェックだけに頼らず、Security Rulesでも認可する）。
      allow create: if request.auth != null
        && request.resource.data.invitedBy == request.auth.uid
        && get(/databases/$(database)/documents/questionSets/$(request.resource.data.setId))
             .data.members[request.auth.uid] == 'owner';
      allow delete: if request.auth != null
        && (request.auth.token.email == email
            || get(/databases/$(database)/documents/questionSets/$(resource.data.setId))
                 .data.members[request.auth.uid] == 'owner');
      allow update: if false;
    }
  }
}
